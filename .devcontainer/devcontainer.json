{
    "name": "Ragazze Digitali - Python",

    "features": {
        "ghcr.io/devcontainers/features/desktop-lite:1": {
            "password": "vscode",
            "webPort": "6080"
        }
    },

    "forwardPorts": [6080],

    "portsAttributes": {
        "6080": {
            "label": "Desktop grafico"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vsliveshare.vsliveshare",
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ]
        }
    }
}
